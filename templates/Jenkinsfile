// callis-check — Jenkins equivalent of templates/callis-check.yml
// (plan §7, ADR 0009/0017).
//
// The workspace must contain: sbom.json, osv/, expected-reachable.txt and
// callis-pin.json ({ "version": "...", "sha256": "..." }).
//
// Same independent-verification contract as the GitHub template:
//   1. download the pinned version,
//   2. check against the digest PINNED IN THIS REPO (never the release's own
//      SHA256SUMS — ADR 0017),
//   3. cosign verify against the documented certificate identity + OIDC
//      issuer,
//   4. run callis and cross-check expected-reachable.txt.
//
// Jenkins agent image: any linux x64 image with curl, jq, python3 and cosign
// (install cosign per https://docs.sigstore.dev/cosign/installation/).

pipeline {
  agent {
    // Pin the agent image in your Jenkins global config; it must be a
    // linux/amd64 image with curl, jq, python3 and cosign.
    label "linux-x64"
  }

  options {
    timestamps()
    // The scheduled run is the drift check; build when the inputs change.
    trigger('h 17 6 * * 1')
    disableConcurrentBuilds()
  }

  environment {
    CALLIS_REPO = "<REPO-OWNER>/callis-js"
  }

  stages (
    // 1) Repo pin — the ONLY value this pipeline trusts for the digest.
    stage("Load pin") {
      steps {
        sh 'jq -r ".version" callis-pin.json > pin-version'
        sh 'jq -r ".sha256" callis-pin.json > pin-sha256'
      }
    }

    stage("Download pinned binary") {
      steps {
        sh 'curl -fsSL -o callis "https://github.com/${CALLIS_REPO}/releases/download/v$(cat pin-version)/callis-linux-x64"'
      }
    }

    // 2) REPO-PINNED digest first: the independent evidence (ADR 0017).
    stage("Verify repo-pinned digest") {
      steps {
        sh 'echo "$(cat pin-sha256)  callis" | sha256sum -c -'
      }
    }

    // 3) cosign: signature + documented certificate identity + OIDC issuer.
    stage("cosign verify") {
      steps {
        sh """\
          cosign verify callis \
            --certificate-identity "<REPO-OWNER>+callis-js@github.com" \
            --certificate-oidc-issuer "https://token.actions.githubusercontent.com""
      }
    }

    stage("Run callis") {
      steps {
        sh "install -m 0755 callis /usr/local/bin/callis"
        sh 'callis --project . --sbom sbom.json --osv-dir osv --format json --output callis-report'
      }
    }

    // 4) Cross-check the verdicts against the repo-pinned expectations.
    stage("Cross-check expected-reachable.txt") {
      steps {
        sh """\
          jq -r '.findings[] | [.id, .verdict] | @tsv' callis-report.json | sort > actual.tsv
          python3 - <<'EOF'
          from pathlib import Path
          import sys

          actual = {}
          for line in Path("actual.tsv").read_text().splitlines():
              if not line.strip():
                  continue
              ident, verdict = line.split("\\t")
              actual[ident] = verdict
          expected = {}
          for line in Path("expected-reachable.txt").read_text().splitlines():
              line = line.strip()
              if not line or line.startswith("#"):
                  continue
              op, ident = line.split(None, 1)
              assert op in ("REACHABLE", "UNREACHABLE", "ABSENT"), f"bad expected line: {line}"
              expected[ident] = op
          failed = False
          for ident, op in expected.items():
              got = actual.get(ident, "no finding")
              if op == "REACHABLE" and got != "REACHABLE":
                  print(f"FAIL: expected REACHABLE {ident}, got {got}")
                  failed = True
              if op == "UNREACHABLE" and got != "UNREACHABLE":
                  print(f"FAIL: expected UNREACHABLE {ident}, got {got}")
                  failed = True
              if op == "ABSENT" and got != "no finding":
                  print(f"FAIL: expected no finding for {ident}, got {got}")
                  failed = True
          for ident, verdict in actual.items():
              if ident not in expected:
                  print(f"FAIL: unexpected finding {ident} ({verdict}) — add it to expected-reachable.txt")
                  failed = True
          sys.exit(1 if failed else 0)
          EOF
        """
      }
    }
  )

  post {
    always {
      archiveArtifacts artifacts: "callis-report.json", allowEmptyArchive: true
    }
  }
}
