{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": false, "clientKind": "git", "root": "." },
  "files": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "coverage/**",
      "bun/**",
      "bun.lock",
      "docs/**",
      "examples/**/node_modules/**",
      "examples/**/install/**",
      "examples/**/out/**",
      "examples/**/osv/**",
      "examples/**/sbom.json",
      "examples/**/vuln-mappings.json",
      "examples/**/package.json",
      "examples/**/.pnp.cjs",
      "examples/**/.yarn/**",
      "examples/**/yarn.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all" },
    "globals": ["Bun"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noInferrableTypes": "off"
      }
    }
  }
}
